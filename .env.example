# AI Finance Assistant - Environment Configuration
# Copy this file to .env and fill in your actual values for local development

# ============================================================================
# LLM & API KEYS
# ============================================================================

# OpenAI API Configuration (Primary LLM Provider)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Configuration (Alternative LLM Provider)
GOOGLE_API_KEY=your-google-gemini-key-here
GOOGLE_MODEL=gemini-2.0-flash

# ============================================================================
# MARKET DATA & EXTERNAL APIs
# ============================================================================

# Alpha Vantage (Stock/Forex data fallback)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here

# FinViz/NewsAPI (Optional - Financial news)
NEWS_API_KEY=your-newsapi-key-here

# ============================================================================
# DATABASE & VECTOR STORE
# ============================================================================

# Chroma Vector Database (Local by default, persists in data/chroma/)
CHROMA_COLLECTION_NAME=finance_knowledge
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# RAG (RETRIEVAL AUGMENTED GENERATION) CONFIGURATION
# ============================================================================

# Document chunking settings
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200

# Retriever settings
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.3

# ============================================================================
# SERVER & DEPLOYMENT SETTINGS
# ============================================================================

# FastAPI Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development

# CORS Configuration (Update for production)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

# WebSocket settings for real-time chat
WS_HEARTBEAT_INTERVAL=30
WS_TIMEOUT=60

# ============================================================================
# WORKFLOW & AGENT SETTINGS
# ============================================================================

# LangGraph Workflow Configuration
WORKFLOW_MAX_ITERATIONS=10
WORKFLOW_TIMEOUT=60

# Agent Settings
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2048

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Enable request/response logging
DEBUG_MODE=false

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend API endpoint (used by React app)
VITE_API_URL=http://localhost:8000

# ============================================================================
# OPTIONAL: PRODUCTION/DOCKER SETTINGS
# ============================================================================

# Database authentication (uncomment for production database)
# DB_USER=postgres
# DB_PASSWORD=your-secure-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=finance_ai

# Redis cache (optional, for session/cache management)
# REDIS_URL=redis://localhost:6379

# AWS/Cloud credentials (optional, for cloud deployment)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_REGION=eu-west-1

# ============================================================================
# NOTES FOR EU COMPLIANCE
# ============================================================================
# - Keep sensitive keys in .env (never commit to git)
# - For EU deployment, ensure CORS_ORIGINS is set to production domain
# - GDPR: Customer data in portfolios should be encrypted at rest
# - Data residency: Consider EU-hosted LLM providers (e.g., Mistral, Aleph Alpha)
# - For production: Use environment-specific .env files (.env.production, .env.staging)
